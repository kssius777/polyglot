      },
      {
        "s": 0,
        "ar": "სიცხე გაქვთ?",
        "translit": "sitskhe gakvt?",
        "fr": "Vous avez de la fièvre ?"
      },
      {
        "s": 1,
        "ar": "კი, ცოტა.",
        "translit": "k'i, tsot'a.",
        "fr": "Oui, un peu."
