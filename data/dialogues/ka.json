[
  {
    "id": "ka-d01",
    "level": 1,
    "situation": "Salutations",
    "title": "Bonjour, comment ça va ?",
    "speakers": [
      "Giorgi",
      "Nino"
    ],
    "lines": [
      {
        "s": 0,
        "ar": "გამარჯობა, ნინო!",
        "translit": "gamarjoba, nino!",
        "fr": "Salut, Nino !"
      },
      {
        "s": 1,
        "ar": "გაგიმარჯოს, გიორგი! როგორ ხარ?",
        "translit": "gagimarjos, giorgi! rogor khar?",
        "fr": "Salut, Giorgi ! Comment vas-tu ?"
      },
      {
        "s": 0,
        "ar": "კარგად, მადლობა. შენ?",
        "translit": "k'argad, madloba. shen?",
        "fr": "Bien, merci. Et toi ?"
      },
      {
        "s": 1,
        "ar": "მეც კარგად ვარ.",
        "translit": "mets k'argad var.",
        "fr": "Moi aussi, je vais bien."
      },
      {
        "s": 0,
        "ar": "ნახვამდის!",
        "translit": "nakhvamdis!",
        "fr": "Au revoir !"
      },
      {
        "s": 1,
        "ar": "კარგად იყავი!",
        "translit": "k'argad iq'avi!",
        "fr": "Prends soin de toi !"
      }
    ]
  },
  {
    "id": "ka-d02",
    "level": 1,
    "situation": "Se présenter",
    "title": "Enchanté !",
    "speakers": [
      "Levan",
      "Mariam"
    ],
    "lines": [
      {
        "s": 0,
        "ar": "გამარჯობათ! მე ლევანი ვარ.",
        "translit": "gamarjobat! me levani var.",
        "fr": "Bonjour ! Je suis Levan."
      },
      {
        "s": 1,
        "ar": "სასიამოვნოა, ლევან. მე მქვია მარიამი.",
        "translit": "sasiamovnoa, levan. me mkvia mariami.",
        "fr": "Enchantée, Levan. Je m'appelle Mariam."
      },
      {
        "s": 0,
        "ar": "საიდან ხართ?",
        "translit": "saidan khart?",
        "fr": "D'où venez-vous ?"
      },
      {
        "s": 1,
        "ar": "თბილისიდან ვარ. თქვენ?",
        "translit": "tbilisidan var. tkven?",
        "fr": "Je suis de Tbilissi. Et vous ?"
      },
      {
        "s": 0,
        "ar": "მე საფრანგეთიდან ვარ.",
        "translit": "me saprangetidan var.",
        "fr": "Moi, je viens de France."
      },
      {
        "s": 1,
        "ar": "ძალიან სასიამოვნოა!",
        "translit": "dzalian sasiamovnoa!",
        "fr": "Ravie de vous rencontrer !"
      }
    ]
  },
  {
    "id": "ka-d03",
    "level": 1,
    "situation": "Au café",
    "title": "Un café, s'il vous plaît",
    "speakers": [
      "Tamar",
      "Dato"
    ],
    "lines": [
      {
        "s": 1,
        "ar": "გამარჯობათ! რას ინებებთ?",
        "translit": "gamarjobat! ras inebebt?",
        "fr": "Bonjour ! Que désirez-vous ?"
      },
      {
        "s": 0,
        "ar": "ერთი ყავა, თუ შეიძლება.",
        "translit": "erti q'ava, tu sheidzleba.",
        "fr": "Un café, s'il vous plaît."
      },
      {
        "s": 1,
        "ar": "შაქრით?",
        "translit": "shakrit?",
        "fr": "Avec du sucre ?"
      },
      {
        "s": 0,
        "ar": "არა, შაქრის გარეშე.",
        "translit": "ara, shakris gareshe.",
        "fr": "Non, sans sucre."
      },
      {
        "s": 1,
        "ar": "კიდევ რამე?",
        "translit": "k'idev rame?",
        "fr": "Autre chose ?"
      },
      {
        "s": 0,
        "ar": "არა, მადლობა. რა ღირს?",
        "translit": "ara, madloba. ra ghirs?",
        "fr": "Non, merci. Ça fait combien ?"
      },
      {
        "s": 1,
        "ar": "ხუთი ლარი.",
        "translit": "khuti lari.",
        "fr": "Cinq laris."
      }
    ]
  },
  {
    "id": "ka-d04",
    "level": 1,
    "situation": "Au marché",
    "title": "Des pommes, s'il vous plaît",
    "speakers": [
      "Eka",
      "Zurab"
    ],
    "lines": [
      {
        "s": 0,
        "ar": "გამარჯობათ! ვაშლი რა ღირს?",
        "translit": "gamarjobat! vashli ra ghirs?",
        "fr": "Bonjour ! Combien coûtent les pommes ?"
      },
      {
        "s": 1,
        "ar": "კილო სამი ლარია.",
        "translit": "k'ilo sami laria.",
        "fr": "Trois laris le kilo."
      },
      {
        "s": 0,
        "ar": "ორი კილო მომეცით, თუ შეიძლება.",
        "translit": "ori k'ilo mometsit, tu sheidzleba.",
        "fr": "Donnez-m'en deux kilos, s'il vous plaît."
      },
      {
        "s": 1,
        "ar": "აი, ინებეთ. ექვსი ლარი.",
        "translit": "ai, inebet. ekvsi lari.",
        "fr": "Voilà, tenez. Six laris."
      },
      {
        "s": 0,
        "ar": "ინებეთ. დიდი მადლობა!",
        "translit": "inebet. didi madloba!",
        "fr": "Tenez. Merci beaucoup !"
      },
      {
        "s": 1,
        "ar": "არაფრის!",
        "translit": "arapris!",
        "fr": "De rien !"
      }
    ]
  },
  {
    "id": "ka-d05",
    "level": 1,
    "situation": "La famille",
    "title": "Tu as des frères et sœurs ?",
    "speakers": [
      "Nika",
      "Ana"
    ],
    "lines": [
      {
        "s": 0,
        "ar": "ანა, და-ძმა გყავს?",
        "translit": "ana, da-dzma gq'avs?",
        "fr": "Ana, tu as des frères et sœurs ?"
      },
      {
        "s": 1,
        "ar": "კი, ერთი ძმა მყავს.",
        "translit": "k'i, erti dzma mq'avs.",
        "fr": "Oui, j'ai un frère."
      },
      {
        "s": 0,
        "ar": "რა ჰქვია?",
        "translit": "ra hkvia?",
        "fr": "Comment s'appelle-t-il ?"
      },
      {
        "s": 1,
        "ar": "დათო ჰქვია. შენ?",
        "translit": "dato hkvia. shen?",
        "fr": "Il s'appelle Dato. Et toi ?"
      },
      {
        "s": 0,
        "ar": "მე ორი და მყავს.",
        "translit": "me ori da mq'avs.",
        "fr": "Moi, j'ai deux sœurs."
      },
      {
        "s": 1,
        "ar": "რა კარგია!",
        "translit": "ra k'argia!",
        "fr": "C'est chouette !"
      }
    ]
  },
  {
    "id": "ka-d06",
    "level": 1,
    "situation": "Demander son chemin",
    "title": "Où est le métro ?",
    "speakers": [
      "Irakli",
      "Ketevan"
    ],
    "lines": [
      {
        "s": 0,
        "ar": "უკაცრავად, მეტრო სად არის?",
        "translit": "uk'atsravad, met'ro sad aris?",
        "fr": "Excusez-moi, où est le métro ?"
      },
      {
        "s": 1,
        "ar": "პირდაპირ წადით, მერე მარჯვნივ.",
        "translit": "p'irdap'ir ts'adit, mere marjvniv.",
        "fr": "Allez tout droit, puis à droite."
      },
      {
        "s": 0,
        "ar": "შორს არის?",
        "translit": "shors aris?",
        "fr": "C'est loin ?"
      },
      {
        "s": 1,
        "ar": "არა, ახლოსაა. ხუთი წუთი.",
        "translit": "ara, akhlosaa. khuti ts'uti.",
        "fr": "Non, c'est tout près. Cinq minutes."
      },
      {
        "s": 0,
        "ar": "დიდი მადლობა!",
        "translit": "didi madloba!",
        "fr": "Merci beaucoup !"
      },
      {
        "s": 1,
        "ar": "არაფრის.",
        "translit": "arapris.",
        "fr": "De rien."
      }
    ]
  },
  {
    "id": "ka-d07",
    "level": 1,
    "situation": "Au restaurant",
    "title": "Un khatchapouri, s'il vous plaît",
    "speakers": [
      "Giorgi",
      "Salomé"
    ],
    "lines": [
      {
        "s": 0,
        "ar": "მენიუ მომიტანეთ, თუ შეიძლება.",
        "translit": "meniu momit'anet, tu sheidzleba.",
        "fr": "Apportez-moi le menu, s'il vous plaît."
      },
      {
        "s": 1,
        "ar": "აი, ინებეთ.",
        "translit": "ai, inebet.",
        "fr": "Voici."
      },
      {
        "s": 0,
        "ar": "ხაჭაპური მინდა და ერთი ჭიქა წყალი.",
        "translit": "khach'ap'uri minda da erti ch'ika ts'q'ali.",
        "fr": "Je voudrais un khatchapouri et un verre d'eau."
      },
      {
        "s": 1,
        "ar": "კარგი. სულ ესაა?",
        "translit": "k'argi. sul esaa?",
        "fr": "Très bien. Ce sera tout ?"
      },
      {
        "s": 0,
        "ar": "კი, მადლობა.",
        "translit": "k'i, madloba.",
        "fr": "Oui, merci."
      },
      {
        "s": 1,
        "ar": "ხაჭაპური ათ წუთში იქნება.",
        "translit": "khach'ap'uri at ts'utshi ikneba.",
        "fr": "Le khatchapouri sera prêt dans dix minutes."
      }
    ]
  },
  {
    "id": "ka-d08",
    "level": 1,
    "situation": "La météo",
    "title": "Il fait froid !",
    "speakers": [
      "Nino",
      "Luka"
    ],
    "lines": [
      {
        "s": 0,
        "ar": "დღეს ძალიან ცივა!",
        "translit": "dghes dzalian tsiva!",
        "fr": "Il fait très froid aujourd'hui !"
      },
      {
        "s": 1,
        "ar": "კი, და ხვალ თოვლი მოვა.",
        "translit": "k'i, da khval tovli mova.",
        "fr": "Oui, et demain il va neiger."
      },
      {
        "s": 0,
        "ar": "მართლა? მე თოვლი მიყვარს.",
        "translit": "martla? me tovli miq'vars.",
        "fr": "Vraiment ? Moi, j'adore la neige."
      },
      {
        "s": 1,
        "ar": "მე არ მიყვარს. ზაფხული მირჩევნია.",
        "translit": "me ar miq'vars. zapkhuli mirchevnia.",
        "fr": "Moi, je n'aime pas ça. Je préfère l'été."
      },
      {
        "s": 0,
        "ar": "ზაფხულში კი ძალიან ცხელა!",
        "translit": "zapkhulshi k'i dzalian tskhela!",
        "fr": "Mais en été, il fait très chaud !"
      }
    ]
  },
  {
    "id": "ka-d09",
    "level": 1,
    "situation": "Au téléphone",
    "title": "Allô, c'est Tamar",
    "speakers": [
      "Tamar",
      "Levan"
    ],
    "lines": [
      {
        "s": 1,
        "ar": "ალო, გისმენთ.",
        "translit": "alo, gisment.",
        "fr": "Allô, j'écoute."
      },
      {
        "s": 0,
        "ar": "გამარჯობა, ლევან! თამარი ვარ.",
        "translit": "gamarjoba, levan! tamari var.",
        "fr": "Salut, Levan ! C'est Tamar."
      },
      {
        "s": 1,
        "ar": "ოჰ, თამარ! როგორ ხარ?",
        "translit": "oh, tamar! rogor khar?",
        "fr": "Oh, Tamar ! Comment vas-tu ?"
      },
      {
        "s": 0,
        "ar": "კარგად. სად ხარ ახლა?",
        "translit": "k'argad. sad khar akhla?",
        "fr": "Bien. Tu es où, là ?"
      },
      {
        "s": 1,
        "ar": "სახლში ვარ.",
        "translit": "sakhlshi var.",
        "fr": "Je suis à la maison."
      },
      {
        "s": 0,
        "ar": "კარგი, საღამოს დაგირეკავ.",
        "translit": "k'argi, saghamos dagirek'av.",
        "fr": "D'accord, je te rappelle ce soir."
      },
      {
        "s": 1,
        "ar": "კარგი, ნახვამდის!",
        "translit": "k'argi, nakhvamdis!",
        "fr": "D'accord, au revoir !"
      }
    ]
  },
  {
    "id": "ka-d10",
    "level": 1,
    "situation": "Dans un magasin",
    "title": "Cette chemise",
    "speakers": [
      "Mariam",
      "Dato"
    ],
    "lines": [
      {
        "s": 0,
        "ar": "უკაცრავად, ეს პერანგი რა ღირს?",
        "translit": "uk'atsravad, es p'erangi ra ghirs?",
        "fr": "Excusez-moi, combien coûte cette chemise ?"
      },
      {
        "s": 1,
        "ar": "ორმოცი ლარი.",
        "translit": "ormotsi lari.",
        "fr": "Quarante laris."
      },
      {
        "s": 0,
        "ar": "სხვა ფერი გაქვთ?",
        "translit": "skhva peri gakvt?",
        "fr": "Vous l'avez dans une autre couleur ?"
      },
      {
        "s": 1,
        "ar": "კი, ლურჯი და თეთრი.",
        "translit": "k'i, lurji da tetri.",
        "fr": "Oui, en bleu et en blanc."
      },
      {
        "s": 0,
        "ar": "თეთრს ავიღებ.",
        "translit": "tetrs avigheb.",
        "fr": "Je prends la blanche."
      },
      {
        "s": 1,
        "ar": "კარგი არჩევანია!",
        "translit": "k'argi archevania!",
        "fr": "Bon choix !"
      }
    ]
  },
  {
    "id": "ka-d11",
    "level": 1,
    "situation": "Transports",
    "title": "Le bus pour le centre",
    "speakers": [
      "Ana",
      "Zurab"
    ],
    "lines": [
      {
        "s": 0,
        "ar": "უკაცრავად, ეს ავტობუსი ცენტრში მიდის?",
        "translit": "uk'atsravad, es avt'obusi tsent'rshi midis?",
        "fr": "Excusez-moi, ce bus va au centre ?"
      },
      {
        "s": 1,
        "ar": "არა, ცენტრში ოცდაორი ნომერი მიდის.",
        "translit": "ara, tsent'rshi otsdaori nomeri midis.",
        "fr": "Non, pour le centre, c'est le vingt-deux."
      },
      {
        "s": 0,
        "ar": "გაჩერება სად არის?",
        "translit": "gachereba sad aris?",
        "fr": "Où est l'arrêt ?"
      },
      {
        "s": 1,
        "ar": "იქ, ქუჩის მეორე მხარეს.",
        "translit": "ik, kuchis meore mkhares.",
        "fr": "Là-bas, de l'autre côté de la rue."
      },
      {
        "s": 0,
        "ar": "მადლობა!",
        "translit": "madloba!",
        "fr": "Merci !"
      },
      {
        "s": 1,
        "ar": "არაფრის.",
        "translit": "arapris.",
        "fr": "De rien."
      }
    ]
  },
  {
    "id": "ka-d12",
    "level": 1,
    "situation": "Chez des amis",
    "title": "Entre, Eka !",
    "speakers": [
      "Nika",
      "Eka"
    ],
    "lines": [
      {
        "s": 0,
        "ar": "შემოდი, ეკა!",
        "translit": "shemodi, ek'a!",
        "fr": "Entre, Eka !"
      },
      {
        "s": 1,
        "ar": "გამარჯობა, ნიკა! ეს შენთვისაა.",
        "translit": "gamarjoba, nik'a! es shentvisaa.",
        "fr": "Salut, Nika ! C'est pour toi."
      },
      {
        "s": 0,
        "ar": "რა ლამაზი ყვავილებია! მადლობა. დაჯექი, ჩაი გინდა?",
        "translit": "ra lamazi q'vavilebia! madloba. dajeki, chai ginda?",
        "fr": "Quelles belles fleurs ! Merci. Assieds-toi, tu veux du thé ?"
      },
      {
        "s": 1,
        "ar": "კი, სიამოვნებით.",
        "translit": "k'i, siamovnebit.",
        "fr": "Oui, avec plaisir."
      },
      {
        "s": 0,
        "ar": "ახლახან ხაჭაპური გამოვაცხვე.",
        "translit": "akhlakhan khach'ap'uri gamovatskhve.",
        "fr": "Je viens de faire un khatchapouri."
      },
      {
        "s": 1,
        "ar": "ვაჰ, რა სურნელია!",
        "translit": "vah, ra surnelia!",
        "fr": "Waouh, ça sent bon !"
      }
    ]
  },
  {
    "id": "ka-d13",
    "level": 1,
    "situation": "Au travail",
    "title": "Tu travailles où ?",
    "speakers": [
      "Irakli",
      "Nino"
    ],
    "lines": [
      {
        "s": 0,
        "ar": "სად მუშაობ?",
        "translit": "sad mushaob?",
        "fr": "Où travailles-tu ?"
      },
      {
        "s": 1,
        "ar": "სკოლაში ვმუშაობ. მასწავლებელი ვარ.",
        "translit": "sk'olashi vmushaob. masts'avlebeli var.",
        "fr": "Je travaille dans une école. Je suis professeure."
      },
      {
        "s": 0,
        "ar": "რას ასწავლი?",
        "translit": "ras asts'avli?",
        "fr": "Qu'est-ce que tu enseignes ?"
      },
      {
        "s": 1,
        "ar": "ინგლისურს. შენ რას საქმიანობ?",
        "translit": "inglisurs. shen ras sakmianob?",
        "fr": "L'anglais. Et toi, tu fais quoi ?"
      },
      {
        "s": 0,
        "ar": "მე ექიმი ვარ, საავადმყოფოში ვმუშაობ.",
        "translit": "me ekimi var, saavadmq'oposhi vmushaob.",
        "fr": "Je suis médecin, je travaille à l'hôpital."
      },
      {
        "s": 1,
        "ar": "საინტერესოა!",
        "translit": "saint'eresoa!",
        "fr": "Intéressant !"
      }
    ]
  },
  {
